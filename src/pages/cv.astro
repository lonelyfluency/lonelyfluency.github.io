---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import { getCV } from '../lib/data';
import { getPublications } from '../lib/publications';
import { Download, Printer } from 'lucide-astro';

const cv = getCV();
const pubs = getPublications();
const cvHeading =
  'border-b border-line pb-2 font-mono text-sm uppercase tracking-[0.14em] text-accent';
---

<BaseLayout title="CV" description={`Curriculum vitae of ${SITE.author.name}.`}>
  <div class="mx-auto max-w-3xl px-5 py-16" id="cv-root">
    <header class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight text-ink">{SITE.author.name}</h1>
        <p class="mt-2 text-muted">{SITE.author.position}</p>
        <p class="mt-1 text-sm text-muted">
          {SITE.author.affiliation} · {SITE.author.location} ·
          <a href={`mailto:${SITE.author.email}`} class="text-accent">{SITE.author.email}</a>
        </p>
      </div>
      <div class="print:hidden flex flex-wrap gap-2">
        <a
          href="/files/Tian_CV.pdf"
          class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-surface transition-opacity duration-150 hover:opacity-90"
        >
          <Download size={15} aria-hidden="true" />
          Download PDF
        </a>
        <button
          id="print-cv"
          type="button"
          class="inline-flex items-center gap-2 rounded-md border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          <Printer size={15} aria-hidden="true" />
          Print this page
        </button>
      </div>
    </header>

    <section class="mt-10">
      <h2 class={cvHeading}>Research Interests</h2>
      <p class="mt-3 text-ink">{cv.interests.join(' · ')}</p>
    </section>

    <section class="mt-10">
      <h2 class={cvHeading}>Education</h2>
      <ol class="mt-4 grid gap-5">
        {
          cv.education.map((e) => (
            <li class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-4">
              <p class="font-mono text-xs text-muted sm:pt-1">{e.period}</p>
              <div>
                <p class="font-medium text-ink">{e.degree}</p>
                <p class="text-sm text-muted">{e.institution}</p>
                {e.detail && <p class="text-sm text-muted">{e.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10">
      <h2 class={cvHeading}>Positions</h2>
      <ol class="mt-4 grid gap-5">
        {
          cv.positions.map((p) => (
            <li class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-4">
              <p class="font-mono text-xs text-muted sm:pt-1">{p.period}</p>
              <div>
                <p class="font-medium text-ink">{p.role}</p>
                <p class="text-sm text-muted">{p.org}</p>
                {p.detail && <p class="text-sm text-muted">{p.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10">
      <h2 class={cvHeading}>Publications</h2>
      <ol class="mt-4 grid gap-4">
        {
          pubs.map((pub) => (
            <li class="text-sm leading-relaxed">
              <p class="text-ink">
                {pub.authors.join(', ')} —
                <span class="font-medium"> {pub.title}.</span>
              </p>
              <p class="text-muted">
                <span class="italic">{[pub.venue, pub.note].filter(Boolean).join(' — ')}</span>, {pub.year}.
                {pub.award && <span class="text-warning"> {pub.award}.</span>}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10">
      <h2 class={cvHeading}>Honors & Awards</h2>
      <ol class="mt-4 grid gap-2.5">
        {
          cv.awards.map((a) => (
            <li class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-4">
              <p class="font-mono text-xs text-muted sm:pt-0.5">{a.date}</p>
              <p class="text-sm text-ink">{a.title}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-10">
      <h2 class={cvHeading}>Skills</h2>
      <dl class="mt-4 grid gap-2.5">
        {
          cv.skills.map((s) => (
            <div class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-4">
              <dt class="font-mono text-xs text-muted sm:pt-0.5">{s.group}</dt>
              <dd class="text-sm text-ink">{s.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  @media print {
    :global(header, footer) {
      display: none !important;
    }
    #cv-root {
      padding: 0;
    }
  }
</style>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>
