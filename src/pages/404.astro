---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-5 py-28 text-center">
    <!-- lost robot: planned path leads off the map -->
    <svg viewBox="0 0 200 80" class="w-64 text-muted" aria-hidden="true">
      <path d="M10 60 C 50 55, 70 40, 100 42" fill="none" stroke="currentColor" stroke-width="2" class="text-accent" stroke-linecap="round" />
      <path d="M104 41 C 130 40, 150 55, 185 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 5" />
      <rect x="97" y="36" width="9" height="9" transform="rotate(45 101 41)" fill="currentColor" class="text-accent" />
      <text x="150" y="70" font-size="9" font-family="monospace" fill="currentColor">path not found</text>
    </svg>
    <h1 class="mt-8 text-6xl font-semibold tracking-tight text-ink">404</h1>
    <p class="mt-4 max-w-md text-muted">
      The planner returned no feasible path to this page. It may have moved
      when the site was rebuilt.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-surface transition-opacity duration-150 hover:opacity-90"
    >
      Replan to home
    </a>
  </div>
</BaseLayout>
