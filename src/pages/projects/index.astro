---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedProjectCard from '../../components/FeaturedProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Projects"
  description="Robotics research projects: capability-aware locomotion, human-style manipulation, adversarial balance control, and field-deployed hexapods."
>
  <div class="mx-auto max-w-6xl px-5 py-16">
    <header class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Projects</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        Research systems
      </h1>
      <p class="mt-4 text-lg text-muted">
        Each project is a complete system — problem, method, hardware, and
        evidence — not just a paper.
      </p>
    </header>

    <div class="mt-12 grid gap-6">
      {projects.map((p) => <FeaturedProjectCard project={p} />)}
    </div>
  </div>
</BaseLayout>
