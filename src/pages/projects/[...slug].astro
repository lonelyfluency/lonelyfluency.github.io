---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchTag from '../../components/ResearchTag.astro';
import { Code2, Database, FileText, Video } from 'lucide-astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, dateRange, status, themes, platforms, methods, collaborators, media, links } =
  project.data;

const resourceLinks = [
  links.paper && { href: links.paper, label: 'Paper', Icon: FileText },
  links.code && { href: links.code, label: 'Code', Icon: Code2 },
  links.video && { href: links.video, label: 'Video', Icon: Video },
  links.dataset && { href: links.dataset, label: 'Dataset', Icon: Database },
].filter(Boolean) as { href: string; label: string; Icon: typeof FileText }[];
---

<BaseLayout title={title} description={summary} image={media.hero}>
  <article class="mx-auto max-w-6xl px-5 py-16">
    <!-- Project hero (design.md §12.2) -->
    <header class="grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="flex flex-wrap gap-1.5">
          {themes.map((t) => <ResearchTag label={t} tone="accent" />)}
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{title}</h1>
        <p class="mt-4 font-serif text-xl leading-relaxed text-ink/85">{summary}</p>

        <dl class="mt-7 grid gap-2.5 text-sm">
          {
            dateRange && (
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wide text-muted">Period</dt>
                <dd class="text-ink">
                  {dateRange}
                  {status === 'active' && <span class="ml-2 font-mono text-xs text-success">● active</span>}
                </dd>
              </div>
            )
          }
          {
            platforms.length > 0 && (
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wide text-muted">Platform</dt>
                <dd class="text-ink">{platforms.join(' · ')}</dd>
              </div>
            )
          }
          {
            methods.length > 0 && (
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wide text-muted">Methods</dt>
                <dd class="text-ink">{methods.join(' · ')}</dd>
              </div>
            )
          }
          {
            collaborators.length > 0 && (
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs uppercase tracking-wide text-muted">With</dt>
                <dd class="text-ink">{collaborators.join(', ')}</dd>
              </div>
            )
          }
        </dl>

        {
          resourceLinks.length > 0 && (
            <div class="mt-7 flex flex-wrap gap-2">
              {resourceLinks.map(({ href, label, Icon }) => (
                <a
                  href={href}
                  class="inline-flex items-center gap-1.5 rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
                  {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <Icon size={14} aria-hidden="true" />
                  {label}
                </a>
              ))}
            </div>
          )
        }
      </div>

      {
        media.hero && (
          <figure class="overflow-hidden rounded-[20px] border border-line bg-white p-2">
            <img
              src={media.hero}
              alt={media.heroAlt ?? ''}
              width="1600"
              height="900"
              decoding="async"
              class="h-auto w-full rounded-xl"
            />
          </figure>
        )
      }
    </header>

    <div class="prose mx-auto mt-16 text-ink/90">
      <Content />
      {
        media.video && (
          <figure>
            <video
              controls
              preload="none"
              poster={media.videoPoster}
              class="mx-auto w-auto max-w-full max-h-[75vh]"
            >
              <source src={media.video} type="video/mp4" />
              Your browser does not support embedded video —
              <a href={media.video}>download the video</a> instead.
            </video>
            <figcaption>Project video.</figcaption>
          </figure>
        )
      }
    </div>
  </article>
</BaseLayout>
