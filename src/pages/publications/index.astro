---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationEntry from '../../components/PublicationEntry.astro';
import { getPublications, getPublicationsByYear } from '../../lib/publications';

const pubs = getPublications();
const byYear = getPublicationsByYear(pubs);

// Offer type filters only for venue types that actually occur.
const typeLabels: Record<string, string> = {
  journal: 'Journal',
  conference: 'Conference',
  workshop: 'Workshop',
  preprint: 'Preprint / Under review',
  thesis: 'Thesis',
  other: 'Other',
};
const presentTypes = Object.keys(typeLabels).filter((t) =>
  pubs.some((p) => p.venueType === t)
);
const filters = [
  { id: 'all', label: 'All' },
  { id: 'selected', label: 'Selected' },
  ...presentTypes.map((t) => ({ id: t, label: typeLabels[t]! })),
];
---

<BaseLayout
  title="Publications"
  description="Publications by Changda Tian on legged robots, capability-aware planning, and learning-based manipulation."
>
  <div class="mx-auto max-w-4xl px-5 py-16">
    <header>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Publications</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Papers</h1>
      <p class="mt-4 max-w-2xl text-muted">
        Generated from <code class="rounded border border-line bg-elevated px-1.5 py-0.5 font-mono text-xs">publications.bib</code> —
        my name in <strong class="text-ink">bold</strong>. Expand any entry for the abstract and citation.
      </p>
    </header>

    <!-- Filters (design.md §11.4): client-light, accessible toggle buttons -->
    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter publications">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class:list={[
              'pub-filter rounded-md border px-3 py-1.5 text-sm font-medium transition-colors duration-150',
              i === 0
                ? 'border-accent bg-accent-soft text-accent'
                : 'border-line bg-surface text-muted hover:border-accent hover:text-accent',
            ]}
            data-filter={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="mt-10 grid gap-10">
      {
        byYear.map(([year, yearPubs]) => (
          <section data-year-group>
            <h2 class="mb-4 border-b border-line pb-2 font-mono text-sm text-muted">{year}</h2>
            <div class="grid gap-4">
              {yearPubs.map((pub) => (
                <PublicationEntry pub={pub} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
    <p data-empty hidden class="mt-10 rounded-xl border border-line bg-surface p-8 text-center text-muted">
      No publications match this filter.
    </p>
  </div>
</BaseLayout>

<script>
  // --- filtering ---
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter');
  const entries = document.querySelectorAll<HTMLElement>('[data-pub]');
  const groups = document.querySelectorAll<HTMLElement>('[data-year-group]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function applyFilter(filter: string) {
    let anyVisible = false;
    entries.forEach((el) => {
      const show =
        filter === 'all' ||
        (filter === 'selected' && el.dataset.selected === 'true') ||
        el.dataset.type === filter;
      el.hidden = !show;
      if (show) anyVisible = true;
    });
    groups.forEach((g) => {
      const visible = g.querySelectorAll('[data-pub]:not([hidden])').length > 0;
      g.hidden = !visible;
    });
    if (empty) empty.hidden = anyVisible;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('border-accent', active);
        b.classList.toggle('bg-accent-soft', active);
        b.classList.toggle('text-accent', active);
        b.classList.toggle('border-line', !active);
        b.classList.toggle('bg-surface', !active);
        b.classList.toggle('text-muted', !active);
      });
      applyFilter(btn.dataset.filter ?? 'all');
    });
  });

  // --- abstract / bibtex expanders ---
  document.querySelectorAll<HTMLButtonElement>('.pub-expand').forEach((btn) => {
    btn.addEventListener('click', () => {
      const entry = btn.closest('[data-pub]');
      const panel = entry?.querySelector<HTMLElement>(`[data-panel="${btn.dataset.target}"]`);
      if (!panel) return;
      const open = !panel.hidden;
      panel.hidden = open;
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  // --- copy BibTeX ---
  document.querySelectorAll<HTMLButtonElement>('.pub-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = 'Copy'), 1500);
      } catch {
        btn.textContent = 'Select & copy manually';
      }
    });
  });
</script>
