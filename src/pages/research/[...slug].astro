---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeIcon from '../../components/ThemeIcon.astro';
import ResearchTag from '../../components/ResearchTag.astro';
import FeaturedProjectCard from '../../components/FeaturedProjectCard.astro';
import { getPublications } from '../../lib/publications';
import PublicationEntry from '../../components/PublicationEntry.astro';

export async function getStaticPaths() {
  const themes = await getCollection('research');
  return themes.map((theme) => ({ params: { slug: theme.id }, props: { theme } }));
}

const { theme } = Astro.props;
const { Content } = await render(theme);

// Projects and publications associated with this theme (by title / tag match)
const projects = (await getCollection('projects'))
  .filter((p) => p.data.themes.includes(theme.data.title))
  .sort((a, b) => a.data.order - b.data.order);
const themeTags = new Set(theme.data.pubTags.map((t) => t.toLowerCase()));
const relatedPubs = getPublications().filter((pub) =>
  (pub.meta.tags ?? []).some((t) => themeTags.has(t.toLowerCase()))
);
---

<BaseLayout title={theme.data.title} description={theme.data.question}>
  <article class="mx-auto max-w-6xl px-5 py-16">
    <header class="max-w-3xl">
      <p class="flex items-center gap-3 text-accent">
        <ThemeIcon icon={theme.data.icon} class="h-9 w-9" />
        <span class="font-mono text-xs uppercase tracking-[0.18em]">Research theme</span>
      </p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        {theme.data.title}
      </h1>
      <p class="mt-5 font-serif text-xl italic leading-relaxed text-ink/85">
        {theme.data.question}
      </p>
      <p class="mt-5 flex flex-wrap gap-1.5">
        {theme.data.methods.map((m) => <ResearchTag label={m} tone="accent" />)}
      </p>
    </header>

    <div class="prose mt-12 text-ink/90">
      <Content />
    </div>

    {
      projects.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-6 text-2xl font-semibold tracking-tight text-ink">Projects in this theme</h2>
          <div class="grid gap-6">
            {projects.map((p) => (
              <FeaturedProjectCard project={p} variant="compact" />
            ))}
          </div>
        </section>
      )
    }

    {
      relatedPubs.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-6 text-2xl font-semibold tracking-tight text-ink">Related publications</h2>
          <div class="grid gap-4">
            {relatedPubs.map((pub) => (
              <PublicationEntry pub={pub} compact />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
