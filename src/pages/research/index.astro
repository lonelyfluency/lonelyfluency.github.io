---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeIcon from '../../components/ThemeIcon.astro';
import ResearchTag from '../../components/ResearchTag.astro';

const themes = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Research"
  description="Research themes: learning-based locomotion control, capability-aware planning, learning from human motion, and legged robot systems."
>
  <div class="mx-auto max-w-6xl px-5 py-16">
    <header class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Research</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        A connected research program
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        My work centers on one question — <span class="font-serif italic text-ink">how do legged
        robots earn reliability in the physical world?</span> — approached today
        through modular robot design and control, and built on earlier work in
        locomotion learning, capability-aware planning, learning from human
        motion, and field-deployed robot systems.
      </p>
    </header>

    <div class="mt-14 grid gap-6">
      {
        themes.map((theme) => (
          <a
            href={`/research/${theme.id}/`}
            class="group grid gap-5 rounded-2xl border border-line bg-surface p-7 transition-colors duration-200 hover:border-accent/60 sm:grid-cols-[auto_1fr] sm:p-9"
          >
            <span class="text-accent">
              <ThemeIcon icon={theme.data.icon} class="h-11 w-11" />
            </span>
            <div>
              <h2 class="text-2xl font-semibold tracking-tight text-ink transition-colors duration-150 group-hover:text-accent">
                {theme.data.title}
              </h2>
              <p class="mt-2 max-w-2xl font-serif text-lg italic leading-relaxed text-ink/80">
                {theme.data.question}
              </p>
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{theme.data.summary}</p>
              <p class="mt-4 flex flex-wrap gap-1.5">
                {theme.data.methods.map((m) => (
                  <ResearchTag label={m} />
                ))}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
