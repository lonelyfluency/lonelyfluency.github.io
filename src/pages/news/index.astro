---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchTag from '../../components/ResearchTag.astro';
import { formatDate } from '../../lib/data';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const rendered = await Promise.all(
  news.map(async (item) => ({ item, Content: (await render(item)).Content }))
);
---

<BaseLayout title="News" description="Academic news and updates from Changda Tian.">
  <div class="mx-auto max-w-3xl px-5 py-16">
    <header>
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">News</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Archive</h1>
      <p class="mt-4 text-muted">
        All updates, newest first — also available as an
        <a href="/rss.xml" class="text-accent underline decoration-accent/40 underline-offset-2 hover:decoration-accent">RSS feed</a>.
      </p>
    </header>

    <ol class="mt-12 grid gap-5">
      {
        rendered.map(({ item, Content }) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <time class="font-mono text-xs text-muted" datetime={item.data.date.toISOString()}>
                {formatDate(item.data.date)}
              </time>
              <ResearchTag label={item.data.category} />
            </div>
            <h2 class="mt-2.5 text-lg font-semibold leading-snug tracking-tight text-ink">
              {item.data.link ? (
                <a href={item.data.link} class="transition-colors duration-150 hover:text-accent">
                  {item.data.title}
                </a>
              ) : (
                item.data.title
              )}
            </h2>
            <div class="mt-2 text-sm leading-relaxed text-muted [&_a]:text-accent [&_a]:underline">
              <Content />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
