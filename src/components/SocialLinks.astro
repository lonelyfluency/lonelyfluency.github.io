---
import { SITE } from '../site.config';
import { Github, GraduationCap, Linkedin, Mail } from 'lucide-astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const links = [
  { href: SITE.social.github, label: 'GitHub', Icon: Github },
  { href: SITE.social.scholar, label: 'Google Scholar', Icon: GraduationCap },
  { href: SITE.social.linkedin, label: 'LinkedIn', Icon: Linkedin },
  { href: `mailto:${SITE.author.email}`, label: 'Email', Icon: Mail },
].filter((l) => l.href && l.href !== 'mailto:');
---

<ul class:list={['flex items-center gap-2', className]}>
  {
    links.map(({ href, label, Icon }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          class="flex rounded-md border border-line bg-surface p-2 text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
          {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <Icon size={16} aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>
