---
/**
 * Signature hero illustration (design.md §7.4, §22).
 * Visual grammar: dashed line = planned motion, solid line = executed motion,
 * point cluster = perception, diamond = decision point, grid = environment.
 * Animation is CSS-only, slow, and disabled under prefers-reduced-motion.
 */
---

<figure
  class="relative overflow-hidden rounded-[20px] border border-line bg-surface"
  aria-label="Stylized diagram of a hexapod robot walking over terrain"
>
  <svg
    viewBox="0 0 640 460"
    role="img"
    aria-labelledby="hero-visual-title hero-visual-desc"
    class="block h-auto w-full"
  >
    <title id="hero-visual-title">Hexapod robot perception, planning, and control</title>
    <desc id="hero-visual-desc">
      A stylized side view of a six-legged robot on uneven terrain. A solid line
      traces the trajectory it has executed, a dashed line shows the path it
      plans to take over obstacles ahead, and a cluster of points marks the
      terrain its sensors perceive within a field-of-view cone.
    </desc>

    <!-- occupancy grid (environment representation), top-left -->
    <g class="text-line" stroke="currentColor" stroke-width="1" opacity="0.75">
      {[0, 1, 2, 3, 4].map((r) => <line x1="42" y1={44 + r * 16} x2="138" y2={44 + r * 16} />)}
      {[0, 1, 2, 3, 4, 5, 6].map((c) => <line x1={42 + c * 16} y1="44" x2={42 + c * 16} y2="108" />)}
    </g>
    <g class="text-accent" fill="currentColor" opacity="0.28">
      <rect x="58" y="60" width="16" height="16" />
      <rect x="74" y="76" width="16" height="16" />
      <rect x="106" y="44" width="16" height="16" />
      <rect x="90" y="92" width="16" height="16" />
    </g>

    <!-- terrain profile -->
    <path
      d="M0 410 L118 410 L148 393 L232 393 L262 410 L330 410 L362 378 L432 378 L458 358 L522 358 L548 386 L640 386"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="text-ink"
      opacity="0.65"
    />
    <!-- terrain hatching -->
    <g class="text-muted" stroke="currentColor" stroke-width="1" opacity="0.35">
      <line x1="40" y1="410" x2="32" y2="420" />
      <line x1="90" y1="410" x2="82" y2="420" />
      <line x1="290" y1="410" x2="282" y2="420" />
      <line x1="395" y1="378" x2="387" y2="388" />
      <line x1="490" y1="358" x2="482" y2="368" />
      <line x1="590" y1="386" x2="582" y2="396" />
    </g>

    <!-- sensor field-of-view cone -->
    <path d="M250 330 L455 250 L462 352 Z" class="text-accent" fill="currentColor" opacity="0.07" />
    <path
      d="M250 330 L455 250 M250 330 L462 352"
      stroke="currentColor"
      stroke-width="1"
      class="text-accent"
      opacity="0.4"
      stroke-dasharray="2 4"
    />

    <!-- perceived point cloud along the terrain ahead -->
    <g class="text-accent" fill="currentColor">
      <circle class="pt-fade" style="animation-delay:0s" cx="340" cy="404" r="2" />
      <circle class="pt-fade" style="animation-delay:.3s" cx="356" cy="386" r="2.2" />
      <circle class="pt-fade" style="animation-delay:.6s" cx="372" cy="373" r="1.8" />
      <circle class="pt-fade" style="animation-delay:.2s" cx="392" cy="371" r="2" />
      <circle class="pt-fade" style="animation-delay:.8s" cx="410" cy="374" r="1.6" />
      <circle class="pt-fade" style="animation-delay:.5s" cx="428" cy="370" r="2.2" />
      <circle class="pt-fade" style="animation-delay:1s" cx="444" cy="360" r="1.8" />
      <circle class="pt-fade" style="animation-delay:.4s" cx="452" cy="349" r="2" />
      <circle class="pt-fade" style="animation-delay:.9s" cx="468" cy="352" r="1.6" />
      <circle class="pt-fade" style="animation-delay:.1s" cx="484" cy="350" r="2.4" />
      <circle class="pt-fade" style="animation-delay:.7s" cx="500" cy="353" r="1.8" />
      <circle class="pt-fade" style="animation-delay:1.1s" cx="514" cy="351" r="2" />
      <circle class="pt-fade" style="animation-delay:.35s" cx="382" cy="366" r="1.4" />
      <circle class="pt-fade" style="animation-delay:.65s" cx="437" cy="366" r="1.4" />
      <circle class="pt-fade" style="animation-delay:.95s" cx="475" cy="344" r="1.4" />
    </g>

    <!-- executed trajectory (solid, draws in slowly) -->
    <path
      class="text-accent traj-draw"
      d="M18 392 C 60 388, 96 384, 128 372 C 152 363, 172 350, 196 342"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
    <!-- planned path (dashed) over the obstacles ahead -->
    <path
      d="M212 338 C 280 322, 320 352, 372 344 C 412 338, 428 322, 470 324 C 510 326, 540 334, 596 330"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-dasharray="6 5"
      class="text-muted"
    />
    <!-- decision point between executed and planned -->
    <rect
      x="199"
      y="333"
      width="10"
      height="10"
      transform="rotate(45 204 338)"
      class="text-accent"
      fill="currentColor"
    />

    <!-- hexapod: joint-link abstraction -->
    <g stroke-linecap="round">
      <!-- body -->
      <rect x="152" y="330" width="96" height="22" rx="8" class="text-ink" fill="none" stroke="currentColor" stroke-width="2.5" />
      <!-- head sensor -->
      <circle cx="250" cy="330" r="4" class="text-accent" fill="currentColor" />
      <!-- legs: hip → knee → foot -->
      <g class="text-ink" stroke="currentColor" stroke-width="2.5" fill="none">
        <path d="M162 352 L150 372 L158 393" />
        <path d="M200 352 L192 374 L200 393" />
        <path d="M238 352 L246 372 L240 393" />
      </g>
      <!-- far-side legs, lighter -->
      <g class="text-ink" stroke="currentColor" stroke-width="2.5" fill="none" opacity="0.35">
        <path d="M176 352 L168 373 L176 392" />
        <path d="M222 352 L230 373 L224 392" />
      </g>
      <!-- joints -->
      <g class="text-accent" fill="currentColor">
        <circle cx="162" cy="352" r="3" />
        <circle cx="200" cy="352" r="3" />
        <circle cx="238" cy="352" r="3" />
        <circle cx="150" cy="372" r="2.5" />
        <circle cx="192" cy="374" r="2.5" />
        <circle cx="246" cy="372" r="2.5" />
      </g>
    </g>

    <!-- coordinate frame -->
    <g class="text-muted" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M34 434 L34 410 M34 410 l-4 6 M34 410 l4 6" />
      <path d="M34 434 L58 434 M58 434 l-6 -4 M58 434 l-6 4" />
    </g>

    <!-- sparse technical annotations -->
    <g class="text-muted font-mono" fill="currentColor" font-size="10">
      <text x="470" y="240">perception</text>
      <text x="540" y="316">planned</text>
      <text x="30" y="376">executed</text>
      <text x="152" y="320">control</text>
      <text x="64" y="448">x</text>
      <text x="22" y="414">z</text>
      <text x="42" y="130">occupancy</text>
    </g>
  </svg>
  <figcaption class="sr-only">
    Illustration of the perception–planning–control loop for a legged robot.
  </figcaption>
</figure>
