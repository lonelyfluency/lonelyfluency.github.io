---
import type { Publication } from '../lib/publications';
import ResearchTag from './ResearchTag.astro';
import { SITE } from '../site.config';
import { Award, Code2, Database, FileText, FolderOpen, Video } from 'lucide-astro';

interface Props {
  pub: Publication;
  /** Compact = homepage style (no abstract/bibtex expanders). */
  compact?: boolean;
}
const { pub, compact = false } = Astro.props;
const isOwner = (name: string) =>
  SITE.author.nameVariants.some((v) => v.toLowerCase() === name.toLowerCase());

const venueLabel = [pub.venue, pub.note].filter(Boolean).join(' — ');

const buttons = [
  pub.meta.pdf && { href: pub.meta.pdf, label: 'Paper', Icon: FileText },
  pub.doi && { href: `https://doi.org/${pub.doi}`, label: 'DOI', Icon: FileText },
  pub.meta.project && { href: pub.meta.project, label: 'Project', Icon: FolderOpen },
  pub.meta.code && { href: pub.meta.code, label: 'Code', Icon: Code2 },
  pub.meta.video && { href: pub.meta.video, label: 'Video', Icon: Video },
  pub.meta.dataset && { href: pub.meta.dataset, label: 'Dataset', Icon: Database },
].filter(Boolean) as { href: string; label: string; Icon: typeof FileText }[];
---

<article
  class="grid gap-5 rounded-2xl border border-line bg-surface p-5 transition-colors duration-200 hover:border-accent/50 sm:grid-cols-[10rem_1fr] sm:p-6"
  data-pub
  data-type={pub.venueType}
  data-year={pub.year}
  data-selected={pub.meta.selected ? 'true' : 'false'}
  data-tags={(pub.meta.tags ?? []).join('|')}
>
  {
    pub.meta.thumbnail ? (
      <div class="hidden sm:block">
        <img
          src={pub.meta.thumbnail}
          alt={pub.meta.thumbnailAlt ?? ''}
          width="320"
          height="200"
          loading="lazy"
          decoding="async"
          class="aspect-[8/5] w-full rounded-lg border border-line bg-white object-cover object-left p-1"
        />
      </div>
    ) : (
      <div class="hidden items-center justify-center rounded-lg border border-line bg-elevated font-mono text-xs text-muted sm:flex">
        {pub.year}
      </div>
    )
  }

  <div class="min-w-0">
    <h3 class="font-serif text-lg font-semibold leading-snug text-ink">{pub.title}</h3>

    <p class="mt-1.5 text-sm text-muted">
      {
        pub.authors.map((a, i) => (
          <>
            <span class:list={isOwner(a) && 'font-semibold text-ink'}>{a}</span>
            {i < pub.authors.length - 1 && ', '}
          </>
        ))
      }
    </p>

    <p class="mt-1 text-sm">
      <span class="italic text-muted">{venueLabel}</span>
      <span class="font-mono text-xs text-muted"> · {pub.year}</span>
    </p>

    {
      pub.award && (
        <p class="mt-2 inline-flex items-center gap-1.5 rounded-md border border-warning/40 bg-warning/10 px-2 py-1 text-xs font-medium text-warning">
          <Award size={13} aria-hidden="true" />
          {pub.award}
        </p>
      )
    }

    {pub.meta.summary && <p class="mt-2.5 text-sm leading-relaxed text-muted">{pub.meta.summary}</p>}

    {
      !compact && (pub.meta.tags ?? []).length > 0 && (
        <p class="mt-3 flex flex-wrap gap-1.5">
          {(pub.meta.tags ?? []).map((t) => (
            <ResearchTag label={t} />
          ))}
        </p>
      )
    }

    <div class="mt-4 flex flex-wrap items-center gap-2">
      {
        buttons.map(({ href, label, Icon }) => (
          <a
            href={href}
            class="inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
            {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon size={13} aria-hidden="true" />
            {label}
          </a>
        ))
      }
      {
        !compact && pub.abstract && (
          <button
            type="button"
            class="pub-expand inline-flex items-center rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
            data-target="abstract"
            aria-expanded="false"
          >
            Abstract
          </button>
        )
      }
      {
        !compact && (
          <button
            type="button"
            class="pub-expand inline-flex items-center rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
            data-target="bibtex"
            aria-expanded="false"
          >
            BibTeX
          </button>
        )
      }
    </div>

    {
      !compact && pub.abstract && (
        <div data-panel="abstract" hidden class="mt-3 rounded-lg border border-line bg-elevated p-4 text-sm leading-relaxed text-muted">
          {pub.abstract}
        </div>
      )
    }
    {
      !compact && (
        <div data-panel="bibtex" hidden class="relative mt-3">
          <pre class="overflow-x-auto rounded-lg border border-line bg-elevated p-4 font-mono text-xs leading-relaxed text-muted"><code>{pub.raw}</code></pre>
          <button
            type="button"
            class="pub-copy absolute right-2 top-2 rounded-md border border-line bg-surface px-2 py-1 font-mono text-[11px] text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
          >
            Copy
          </button>
        </div>
      )
    }
  </div>
</article>
