---
import { Sun, Moon } from 'lucide-astro';
---

<button
  id="theme-toggle"
  type="button"
  class="rounded-md border border-line bg-surface p-2 text-muted transition-colors duration-150 hover:text-ink"
  aria-label="Toggle dark mode"
>
  <Sun size={16} class="hidden dark:block" aria-hidden="true" />
  <Moon size={16} class="block dark:hidden" aria-hidden="true" />
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>
