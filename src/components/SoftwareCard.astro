---
import type { SoftwareItem } from '../lib/data';
import ResearchTag from './ResearchTag.astro';
import { BookOpen, FileText, Github } from 'lucide-astro';

interface Props {
  item: SoftwareItem;
}
const { item } = Astro.props;

const statusTone: Record<SoftwareItem['status'], string> = {
  stable: 'text-success',
  active: 'text-success',
  research: 'text-accent',
  archived: 'text-muted',
  planned: 'text-warning',
};
---

<article class="flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 transition-colors duration-200 hover:border-accent/50">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-mono text-base font-semibold text-ink">{item.name}</h3>
    <span class:list={['inline-flex items-center gap-1.5 font-mono text-[11px]', statusTone[item.status]]}>
      <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
      {item.status}
    </span>
  </div>
  <p class="text-sm font-medium text-ink/80">{item.problem}</p>
  <p class="text-sm leading-relaxed text-muted">{item.description}</p>
  <p class="flex flex-wrap gap-1.5">
    {item.platforms.map((p) => <ResearchTag label={p} />)}
  </p>
  <div class="mt-auto flex flex-wrap gap-2 pt-2">
    {
      item.repo && (
        <a
          href={item.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          <Github size={13} aria-hidden="true" />
          Repository
        </a>
      )
    }
    {
      item.docs && (
        <a
          href={item.docs}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          <BookOpen size={13} aria-hidden="true" />
          Docs
        </a>
      )
    }
    {
      item.paper && (
        <a
          href={item.paper}
          class="inline-flex items-center gap-1.5 rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          <FileText size={13} aria-hidden="true" />
          Paper
        </a>
      )
    }
  </div>
</article>
