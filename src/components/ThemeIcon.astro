---
/** Minimal line icons for research themes, in the site's visual grammar. */
interface Props {
  icon: 'locomotion' | 'planning' | 'manipulation' | 'systems';
  class?: string;
}
const { icon, class: className = 'h-8 w-8' } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    icon === 'locomotion' && (
      <>
        {/* leg linkage over terrain */}
        <path d="M4 26h24" opacity="0.5" />
        <path d="M10 8h12" />
        <path d="M12 8l-4 9 5 9" />
        <path d="M22 8l4 9-5 9" />
        <circle cx="12" cy="8" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="22" cy="8" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="8" cy="17" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="26" cy="17" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    icon === 'planning' && (
      <>
        {/* dashed planned path with decision diamond */}
        <path d="M4 26 C 10 24, 10 14, 16 14" />
        <path d="M16 14 C 22 14, 22 8, 28 6" stroke-dasharray="3 3" />
        <rect x="13.6" y="11.6" width="4.8" height="4.8" transform="rotate(45 16 14)" fill="currentColor" stroke="none" />
        <circle cx="4" cy="26" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="28" cy="6" r="1.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    icon === 'manipulation' && (
      <>
        {/* two-link arm with gripper */}
        <path d="M6 27h8" />
        <path d="M10 27L13 16" />
        <path d="M13 16l8-6" />
        <circle cx="13" cy="16" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="10" cy="27" r="1.6" fill="currentColor" stroke="none" />
        <path d="M21 10l4-2M21 10l1 4.5" />
        <circle cx="27" cy="6.5" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="23" cy="16" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    icon === 'systems' && (
      <>
        {/* control loop */}
        <path d="M16 5 A 11 11 0 1 1 5.5 12" />
        <path d="M5.5 12l-2.5-4M5.5 12l4.5-1.5" />
        <circle cx="16" cy="5" r="1.8" fill="currentColor" stroke="none" />
        <circle cx="27" cy="16" r="1.8" fill="currentColor" stroke="none" />
        <circle cx="16" cy="27" r="1.8" fill="currentColor" stroke="none" />
      </>
    )
  }
</svg>
