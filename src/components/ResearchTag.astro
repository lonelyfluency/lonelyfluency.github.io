---
interface Props {
  label: string;
  tone?: 'default' | 'accent';
}
const { label, tone = 'default' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-[11px] leading-5',
    tone === 'accent'
      ? 'border-accent/30 bg-accent-soft text-accent'
      : 'border-line bg-elevated text-muted',
  ]}
>
  {label}
</span>
