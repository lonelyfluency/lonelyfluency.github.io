---
import type { CollectionEntry } from 'astro:content';
import ResearchTag from './ResearchTag.astro';
import { ArrowUpRight, FileText, Github, Video } from 'lucide-astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Layout variant (design.md §9.3): landscape | split | compact */
  variant?: 'landscape' | 'split' | 'compact';
}
const { project, variant = project.data.variant } = Astro.props;
const { title, summary, themes, platforms, methods, media, links, dateRange, status } =
  project.data;
const href = `/projects/${project.id}/`;

const resourceLinks = [
  links.paper && { href: links.paper, label: 'Paper', Icon: FileText },
  links.code && { href: links.code, label: 'Code', Icon: Github },
  links.video && { href: links.video, label: 'Video', Icon: Video },
].filter(Boolean) as { href: string; label: string; Icon: typeof FileText }[];
---

<article
  class:list={[
    'group overflow-hidden rounded-2xl border border-line bg-surface transition-colors duration-200 hover:border-accent/60',
    variant === 'split' && 'grid md:grid-cols-2',
    variant === 'compact' && 'grid md:grid-cols-[2fr_3fr]',
  ]}
>
  {
    media.hero && (
      <a
        href={href}
        tabindex="-1"
        aria-hidden="true"
        class:list={[
          'block overflow-hidden bg-elevated',
          variant === 'landscape' ? 'max-h-80' : 'h-full max-h-72 md:max-h-none',
        ]}
      >
        <img
          src={media.hero}
          alt=""
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.025]"
        />
      </a>
    )
  }
  <div class="flex flex-col gap-4 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
      {themes.slice(0, 2).map((t) => <ResearchTag label={t} tone="accent" />)}
      {dateRange && <span class="font-mono">{dateRange}</span>}
      {
        status === 'active' && (
          <span class="inline-flex items-center gap-1.5 font-mono text-success">
            <span class="h-1.5 w-1.5 rounded-full bg-success" />
            active
          </span>
        )
      }
    </div>
    <h3 class="text-xl font-semibold tracking-tight text-ink sm:text-2xl">
      <a href={href} class="transition-colors duration-150 group-hover:text-accent">
        {title}
      </a>
    </h3>
    <p class="text-[15px] leading-relaxed text-muted">{summary}</p>
    {
      (platforms.length > 0 || methods.length > 0) && (
        <dl class="grid gap-1 font-mono text-xs text-muted">
          {platforms.length > 0 && (
            <div class="flex gap-2">
              <dt class="text-ink/70">Platform:</dt>
              <dd>{platforms.join(' · ')}</dd>
            </div>
          )}
          {methods.length > 0 && (
            <div class="flex gap-2">
              <dt class="text-ink/70">Methods:</dt>
              <dd>{methods.join(' · ')}</dd>
            </div>
          )}
        </dl>
      )
    }
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
      <a
        href={href}
        class="inline-flex items-center gap-1 rounded-md bg-accent-soft px-3 py-1.5 text-sm font-medium text-accent transition-colors duration-150 hover:bg-accent hover:text-surface"
      >
        Project
        <ArrowUpRight size={14} aria-hidden="true" />
      </a>
      {
        resourceLinks.map(({ href: rHref, label, Icon }) => (
          <a
            href={rHref}
            class="inline-flex items-center gap-1.5 rounded-md border border-line px-3 py-1.5 text-sm text-muted transition-colors duration-150 hover:border-accent hover:text-accent"
          >
            <Icon size={14} aria-hidden="true" />
            {label}
          </a>
        ))
      }
    </div>
  </div>
</article>
