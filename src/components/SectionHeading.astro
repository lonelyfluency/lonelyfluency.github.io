---
interface Props {
  /** Small mono label above the title, e.g. "02 · Research" */
  eyebrow?: string;
  title: string;
  /** Optional link to a page with the full list. */
  more?: { href: string; label: string };
}
const { eyebrow, title, more } = Astro.props;
---

<div class="mb-10 flex items-end justify-between gap-4">
  <div>
    {
      eyebrow && (
        <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-accent">{eyebrow}</p>
      )
    }
    <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h2>
  </div>
  {
    more && (
      <a
        href={more.href}
        class="hidden shrink-0 text-sm font-medium text-muted transition-colors duration-150 hover:text-accent sm:block"
      >
        {more.label} →
      </a>
    )
  }
</div>
