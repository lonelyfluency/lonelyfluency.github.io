---
import { SITE } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
import { FileText, Menu, X } from 'lucide-astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header
  class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a
      href="/"
      class="group flex items-center gap-2.5 font-semibold tracking-tight text-ink"
      aria-label={`${SITE.author.name} — home`}
    >
      <!-- logo mark: two linked robot modules on legs (modular legged robots) -->
      <svg
        width="26"
        height="26"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-200 group-hover:translate-x-0.5"
      >
        <g class="text-ink" fill="currentColor">
          <rect x="4" y="11" width="11" height="6.5" rx="2" />
          <rect x="16.8" y="11" width="11.2" height="6.5" rx="2" />
        </g>
        <g class="text-ink" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 17.5 L5.5 23 L9.5 27.5" />
          <path d="M23.5 17.5 L26 23 L22 27.5" />
        </g>
        <path d="M15 12.4v3.7" class="text-accent" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <g class="text-accent" fill="currentColor">
          <circle cx="25.4" cy="14.2" r="1.5" />
          <circle cx="8" cy="17.5" r="1.6" />
          <circle cx="23.5" cy="17.5" r="1.6" />
        </g>
      </svg>
      <span>{SITE.author.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-md px-3 py-1.5 text-sm transition-colors duration-150',
              isActive(item.href)
                ? 'text-accent font-medium'
                : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-3 -bottom-[13px] h-0.5 rounded-full bg-accent" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/cv/"
        class="hidden items-center gap-1.5 rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium text-ink transition-colors duration-150 hover:border-accent hover:text-accent sm:flex"
      >
        <FileText size={15} aria-hidden="true" />
        CV
      </a>
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md border border-line bg-surface p-2 text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Menu size={18} class="menu-open" aria-hidden="true" />
        <X size={18} class="menu-close hidden" aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Mobile navigation: one level deep, no nesting (design.md §5.1) -->
  <nav id="mobile-nav" class="hidden border-t border-line bg-surface md:hidden" aria-label="Mobile">
    <div class="mx-auto grid max-w-6xl gap-1 px-5 py-3">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-[15px]',
              isActive(item.href) ? 'bg-accent-soft text-accent font-medium' : 'text-ink hover:bg-elevated',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/cv/" class="rounded-md px-3 py-2 text-[15px] text-ink hover:bg-elevated">CV</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    nav?.classList.toggle('hidden', open);
    btn.querySelector('.menu-open')?.classList.toggle('hidden', !open);
    btn.querySelector('.menu-close')?.classList.toggle('hidden', open);
  });
</script>
