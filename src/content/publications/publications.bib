@article{ma2025manipulate,
  title    = {Manipulate as Human: Learning Task-oriented Manipulation Skills by Adversarial Motion Priors},
  author   = {Ma, Ziqi and Tian, Changda and Gao, Yue},
  journal  = {Robotica},
  volume   = {43},
  number   = {6},
  pages    = {2320--2332},
  year     = {2025},
  doi      = {10.1017/S0263574725001444},
  url      = {https://www.cambridge.org/core/journals/robotica/article/manipulate-as-human-learning-taskoriented-manipulation-skills-by-adversarial-motion-priors/74AC9205DD0BB47D7905E4764B4E61F2},
  abstract = {In recent years, there has been growing interest in developing robots and autonomous systems that can interact with human in a more natural and intuitive way. One of the key challenges in achieving this goal is to enable these systems to manipulate objects and tools in a manner that is similar to that of humans. In this paper, we propose a novel approach for learning human-style manipulation skills by using adversarial motion priors, which we name HMAMP. The approach leverages adversarial networks to model the complex dynamics of tool and object manipulation and the aim of the manipulation task. The discriminator is trained using a combination of real-world data and simulation data executed by the agent, which is designed to train a policy that generates realistic motion trajectories that match the statistical properties of human motion. We evaluated HMAMP on one challenging manipulation task: hammering, and the results indicate that HMAMP is capable of learning human-style manipulation skills that outperform current baseline methods. Additionally, we demonstrate that HMAMP has potential for real-world applications by performing real robot arm hammering tasks. In general, HMAMP represents a significant step towards developing robots and autonomous systems that can interact with humans in a more natural and intuitive way, by learning to manipulate tools and objects in a manner similar to how humans do.},
}

@inproceedings{argiropoulos2025torque,
  title     = {Optimal Torque Distribution via Dynamic Adaptation for Quadrupedal Locomotion on Slippery Terrains},
  author    = {Argiropoulos, Despina-Ekaterini and Maravgakis, Michael and Tian, Changda and Papageorgiou, Dimitrios and Trahanias, Panos},
  booktitle = {2025 IEEE International Conference on Robotics and Automation (ICRA)},
  pages     = {5343--5349},
  year      = {2025},
  doi       = {10.1109/ICRA55743.2025.11128680},
  url       = {https://ieeexplore.ieee.org/document/11128680},
  abstract  = {As legged robots continue to evolve, new control methods are being developed to provide fast, robust, accurate and computationally efficient algorithms for traversing challenging environments. This paper presents a realtime adaptive locomotion controller for quadrupeds, designed to maintain stability and controllability on various surfaces, including highly slippery terrains. The proposed approach optimizes control effort distribution based on the probability of slippage by utilizing a surface-independent adaptation layer. By balancing the robot's redundant kinematic system through rank relaxation, similar to loosening constraints in optimization problems, this method demonstrates significant performance improvements. Unlike Reinforcement Learning (RL) approaches, which depend on pre-trained policies and may struggle to adapt velocity tracking control across different terrains, our method rapidly adjusts to changing conditions, as validated by extensive simulation experiments.},
}

@inproceedings{gao2024capability,
  title     = {Learning Capability to Enhance Locomotion Control and Planning for Legged Robots},
  author    = {Gao, Yue and Tian, Changda and Zhang, Yang},
  booktitle = {2024 IEEE International Conference on Real-time Computing and Robotics (RCAR)},
  pages     = {25--30},
  year      = {2024},
  doi       = {10.1109/RCAR61438.2024.10671189},
  url       = {https://ieeexplore.ieee.org/document/10671189},
  abstract  = {Legged robots possess diverse motion modes and can adapt to various complex terrains through the combination of motion skills. However, the lack of an effective definition for different motion capabilities hinders the rapid adjustment of the robot's topology and motion controller parameters in response to terrain changes, thereby limiting the locomotion performance of legged robots. In this paper, we propose a hierarchical learning-based motion capability space representation and scheduling policy to enhance the performance of the navigation control system for legged robots. At the lower level, we employ reinforcement learning to explore the capability characteristics of mechanical topology and motion controllers. The upper-level ability abstraction network is used to construct the distribution of the motion capability space. Subsequently, the capability information is used to improve the performance of the path planning algorithm. We validate our approach through simulations and experiments on the hexapod robot Qingzhui. The results demonstrate that our method significantly improves the navigation motion performance of legged robots.},
}

@inproceedings{tian2022capplanner,
  title     = {CapPlanner: Adaptable to Various Topology and Locomotion Capability for Hexapod Robots},
  author    = {Tian, Changda and Gao, Yue},
  booktitle = {2022 IEEE International Conference on Robotics and Biomimetics (ROBIO)},
  pages     = {519--524},
  year      = {2022},
  doi       = {10.1109/ROBIO55434.2022.10011967},
  url       = {https://ieeexplore.ieee.org/document/10011967},
  award     = {Best Paper in Biomimetics — Finalist},
  abstract  = {We present CapPlanner, a hierarchical motion control and planning system which can do long-range locomotion control and planning according to the learned traverse capability of the robot in different topologies. It consists of two layers: the bottom-level controller computes the trajectory of the body and the feet according to the terrain, local target and current feet positions, and controls the motors to track the calculated trajectory. The top-level controller learns the traverse ability of the robot with its bottom-level controller by simulating locomotion tasks on various terrains and in different topologies. Hence CapPlanner can guide the robot to reach a long-term destination with a much higher success rate.},
}

@inproceedings{yang2019simtoreal,
  title     = {Sim-to-Real: Designing Locomotion Controller for Six-Legged Robot},
  author    = {Yang, Chenyu and Gao, Yue and Tian, Changda and Yao, QingShan},
  booktitle = {2019 IEEE 9th Annual International Conference on CYBER Technology in Automation, Control, and Intelligent Systems (CYBER)},
  pages     = {746--751},
  year      = {2019},
  doi       = {10.1109/CYBER46603.2019.9066720},
  url       = {https://ieeexplore.ieee.org/document/9066720},
  abstract  = {Legged robots can be utilized in unstructured environments, and the locomotion and motion planning of legged robots are of great importance. Six-legged robots are more challenging to control due to their multiple-input, multiple-output, multiple end-effectors properties. By utilizing the sim-to-real technique, we can avoid the limitation of learning a controller on a real physical system. In this paper, we designed a hierarchical controller by utilizing deep reinforcement learning methods to perform the tasks of navigation through obstacles and locomotion control. The high-level controller navigates through obstacles and generates the footholds, and the low-level controller controls each leg to move the end-effector to the designated footholds. This combination of a learning hierarchical controller and human design is more practical than end-to-end learning methods because prior knowledge can be efficiently transferred to the learning process. The applicability of the policy network is tested on both a simulated and a real physical six-legged robot with promising results.},
}
